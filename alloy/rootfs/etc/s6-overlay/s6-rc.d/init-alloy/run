#!/usr/bin/with-contenv bash
# Vult het Alloy-sjabloon met de add-on-opties. Geen heredoc met Alloy-syntaxis: het sjabloon
# staat los in /etc/alloy/config.alloy.tpl, zodat regex-escapes letterlijk blijven.
set -e

CONFIG_DIR="/etc/alloy"
TEMPLATE="${CONFIG_DIR}/config.alloy.tpl"
CONFIG_FILE="${CONFIG_DIR}/config.alloy"
OPTIONS_FILE="/data/options.json"

mkdir -p "${CONFIG_DIR}" /data/alloy

LOKI_URL=$(jq -r '.loki_url' "${OPTIONS_FILE}")
HOST_LABEL=$(jq -r '.host // "ha"' "${OPTIONS_FILE}")
MAX_AGE=$(jq -r '.max_age // "720h"' "${OPTIONS_FILE}")
LOG_LEVEL=$(jq -r '.log_level // "info"' "${OPTIONS_FILE}")
ADDITIONAL_CONFIG=$(jq -r '.additional_config // ""' "${OPTIONS_FILE}")

case "${HOST_LABEL}" in
  *[!a-zA-Z0-9_-]*|"") echo "host mag alleen letters, cijfers, - en _ bevatten: '${HOST_LABEL}'" >&2; exit 1 ;;
esac

# HAOS schrijft de journal persistent (/var/log/journal) of vluchtig (/run/log/journal).
JOURNAL_PATH="/var/log/journal"
if [ ! -d "${JOURNAL_PATH}" ] || [ -z "$(ls -A "${JOURNAL_PATH}" 2>/dev/null)" ]; then
    JOURNAL_PATH="/run/log/journal"
fi

echo "-----------------------------------------------------------"
echo " Grafana Alloy → Logarchief"
echo " loki_url:  ${LOKI_URL}"
echo " host:      ${HOST_LABEL}"
echo " journal:   ${JOURNAL_PATH}"
echo " max_age:   ${MAX_AGE}"
echo " log_level: ${LOG_LEVEL}"
echo "-----------------------------------------------------------"

sed -e "s|__LOKI_URL__|${LOKI_URL}|g" \
    -e "s|__HOST__|${HOST_LABEL}|g" \
    -e "s|__JOURNAL_PATH__|${JOURNAL_PATH}|g" \
    -e "s|__MAX_AGE__|${MAX_AGE}|g" \
    -e "s|__LOG_LEVEL__|${LOG_LEVEL}|g" \
    "${TEMPLATE}" > "${CONFIG_FILE}"

if [ -n "${ADDITIONAL_CONFIG}" ] && [ "${ADDITIONAL_CONFIG}" != "null" ]; then
    {
      echo ""
      echo "// --- additional_config uit de add-on-opties ---"
      echo "${ADDITIONAL_CONFIG}"
    } >> "${CONFIG_FILE}"
fi

/usr/bin/alloy validate "${CONFIG_FILE}"
echo "Alloy-config gegenereerd en gevalideerd: ${CONFIG_FILE}"
